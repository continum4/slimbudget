{% extends 'base.twig' %}
{% block title %}{{ t('two_step.title') }}{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>{{ t('two_step.title') }}</h1>
  {% if error %}<p class="notice error" role="alert"><span class="icon" aria-hidden="true">▲</span> {{ error }}</p>{% endif %}
  <form method="post" action="/login/code">
    {{ csrf() }}
    <div class="field"><label for="code">{{ t('two_step.code') }}</label><small id="code-hint">{{ t('two_step.code_or_recovery') }}</small><input id="code" name="code" class="code" autocomplete="one-time-code" inputmode="numeric" autocapitalize="none" autocorrect="off" spellcheck="false" maxlength="24" enterkeyhint="done" aria-describedby="code-hint" required autofocus></div>
    <details class="more"><summary>{{ t('two_step.no_phone') }}</summary><p class="note">{{ t('two_step.no_phone_help') }}</p></details>
    <button class="primary">{{ t('login.submit') }}</button>
  </form>
  <p><a href="/login">{{ t('two_step.start_over') }}</a></p>
</section>
{% endblock %}
