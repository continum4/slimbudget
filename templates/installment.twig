{% extends 'base.twig' %}
{% block title %}{{ t('installments.edit') }}{% endblock %}
{% block content %}
<section class="card edit">
  <h1>{{ t('installments.edit') }}</h1>
  {% if plan.note %}<p class="notice info"><span class="icon" aria-hidden="true">◔</span> {{ plan.note }}</p>{% endif %}
  <form method="post" action="/installments/{{ plan.id }}" class="form-grid two-col">{{ csrf() }}
    {% set end_month %}<div class="field"><label for="end_month">{{ t('installments.last_month') }}</label><input type="month" id="end_month" name="end_month" placeholder="YYYY-MM" pattern="20\d\d-(0[1-9]|1[0-2])" value="{{ old('end_month', plan.end_month) }}" required></div>{% endset %}
    {{ include('_plan_fields.twig', {v: plan, end_month: end_month}) }}
    <div class="field wide"><label for="note">{{ t('app.optional', {label: t('fields.note')}) }}</label><input id="note" name="note" maxlength="255" value="{{ old('note', plan.note) }}"></div>
    <div class="field wide check-row"><label><input type="checkbox" name="settled" value="1"{% if plan.settled %} checked{% endif %}> {{ t('installments.settled') }}</label></div>
    <div class="form-actions wide"><button class="primary">{{ t('app.save') }}</button><a class="button" href="/months/{{ current_ym }}/installments">{{ t('app.cancel') }}</a><button class="danger" form="delete-plan">{{ t('installments.delete') }}</button></div>
  </form>
  <form id="delete-plan" method="post" action="/installments/{{ plan.id }}/delete" data-confirm="{{ t('app.confirm_delete', {name: plan.concept}) }}">{{ csrf() }}</form>
</section>
{% endblock %}
