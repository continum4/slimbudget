{% extends 'base.twig' %}
{% block title %}{{ year }}{% endblock %}
{% block content %}
<div class="page-head"><h1>{{ t('year.title') }}</h1><nav class="month-nav" aria-label="{{ t('year.change') }}"><a href="/years/{{ year - 1 }}" aria-label="{{ t('year.previous') }}"><span aria-hidden="true">‹</span></a><strong>{{ year }}</strong><a href="/years/{{ year + 1 }}" aria-label="{{ t('year.next') }}"><span aria-hidden="true">›</span></a></nav></div>
{% if not months %}<section class="card"><p>{{ t('year.empty', {year: year}) }}</p></section>{% else %}
<section class="card">{{ include('_chart.twig', {c: chart, title: t('year.chart')}) }}</section>
<section class="card"><h2>{{ t('year.by_group') }}</h2><p class="note below">{{ t('year.rounded') }}</p><div class="scroll-x" tabindex="0" role="region" aria-label="{{ t('year.by_group') }}"><table class="sticky-first"><caption class="visually-hidden">{{ t('year.by_group') }}</caption>
  <thead><tr><th scope="col">{{ t('fields.group') }}</th>{% for m in months %}<th scope="col" class="num"><a href="/months/{{ m }}">{{ m|month_short }}</a></th>{% endfor %}<th scope="col" class="num">{{ t('app.total') }}</th></tr></thead>
  <tbody>{% for name, values in table %}<tr><th scope="row">{{ name }}</th>{% for m in months %}<td class="num">{{ (values[m] ?? 0)|money_round }}</td>{% endfor %}<td class="num"><strong>{{ values|reduce((a, b) => a + b, 0)|money_round }}</strong></td></tr>{% endfor %}</tbody>
  <tfoot>{% for key, values in totals %}<tr><th scope="row">{{ t('year.' ~ key) }}</th>{% for v in values %}<td class="num">{{ v|money_round }}</td>{% endfor %}<td class="num">{{ values|reduce((a, b) => a + b, 0)|money_round }}</td></tr>{% endfor %}
  <tr><th scope="row">{{ t('fields.balance') }}</th>{% for v in totals.income %}{% set b = v - totals.paid[loop.index0] %}<td class="num{% if b < 0 %} negative{% endif %}">{{ b|money_round }}</td>{% endfor %}<td class="num">{{ (totals.income|reduce((a, b) => a + b, 0) - totals.paid|reduce((a, b) => a + b, 0))|money_round }}</td></tr></tfoot>
</table></div></section>
{% endif %}
{% endblock %}
