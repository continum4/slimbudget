{% import '_macros.twig' as ui %}
<div class="field"><label for="card_id">{{ t('fields.card') }}</label>{{ ui.select('card_id', cards, old('card_id', v.card_id)) }}</div>
<div class="field wide"><label for="concept">{{ t('installments.concept') }}</label><input id="concept" name="concept" maxlength="120" value="{{ old('concept', v.concept) }}" required></div>
{{ ui.amount('total_amount', t('installments.total'), old('total_amount', v.total_amount|amount)) }}
<div class="field"><label for="installments">{{ t('installments.count') }}</label><input type="number" id="installments" name="installments" min="1" max="120" value="{{ old('installments', v.installments) }}" required></div>
<div class="field"><label for="start_month">{{ t('installments.first_month') }}</label><input type="month" id="start_month" name="start_month" placeholder="YYYY-MM" pattern="20\d\d-(0[1-9]|1[0-2])" value="{{ old('start_month', v.start_month) }}" required></div>
<div class="field"><label for="purchased_on">{{ t('app.optional', {label: t('installments.purchased_on')}) }}</label><input type="date" id="purchased_on" name="purchased_on" value="{{ old('purchased_on', v.purchased_on) }}"></div>
<div class="field"><label for="merchant">{{ t('app.optional', {label: t('fields.merchant')}) }}</label><input id="merchant" name="merchant" list="merchants" maxlength="80" value="{{ old('merchant', v.merchant) }}"></div>
{{ ui.merchants(merchants) }}
