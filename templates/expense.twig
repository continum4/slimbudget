{% extends 'base.twig' %}
{% block title %}{{ t('expenses.edit') }}{% endblock %}
{% block content %}
<section class="card"><h1>{{ t('expenses.edit') }}</h1>
  <p class="note">{{ t('expenses.edit_note', {month: expense.ym|month}) }}{% if expense.note %} {{ t('fields.note') }}: {{ expense.note }}.{% endif %}</p>
  <form method="post" action="/expenses/{{ expense.id }}" class="form-grid">{{ csrf() }}
    {{ include('_expense_fields.twig', {v: expense}) }}
    {% if expense.needs_review %}<div class="field"><label><input type="checkbox" name="needs_review" value="1" checked> {{ t('expenses.still_review') }}</label></div>{% endif %}
    <div class="field form-end"><button class="primary">{{ t('app.save') }}</button> <a class="button" href="/months/{{ expense.ym }}/expenses">{{ t('app.cancel') }}</a></div>
  </form>
  <form method="post" action="/expenses/{{ expense.id }}/delete" data-confirm="{{ t('app.confirm_delete', {name: expense.description ~ ' (' ~ expense.amount|money ~ ')'}) }}">{{ csrf() }}<button class="danger">{{ t('expenses.delete') }}</button></form>
</section>
{% endblock %}
