{% extends 'base.twig' %}
{% block title %}{{ t('users.edit') }}{% endblock %}
{% block content %}
<section class="card edit">
  <div class="page-head"><h1>{{ t('users.edit') }}</h1><p class="note">{{ t('users.last_login') }}: {{ user.last_login_at|datetime }}</p></div>
  <form method="post" action="/users/{{ user.id }}" class="form-grid two-col">{{ csrf() }}
    {{ include('_user_fields.twig', {v: user}) }}
    <div class="field wide check-row"><label><input type="checkbox" name="active" value="1"{% if user.active %} checked{% endif %}> {{ t('app.active') }}</label>
      {% if user.id != me.id %}<label><input type="checkbox" name="reset_password" value="1"> {{ t('users.reset') }}</label>
      {% if user.totp_secret %}<label><input type="checkbox" name="two_step_off" value="1"> {{ t('users.two_step_off') }}</label>{% endif %}{% endif %}</div>
    <div class="form-actions wide"><button class="primary">{{ t('app.save') }}</button><a class="button" href="/users">{{ t('app.cancel') }}</a></div>
  </form>
</section>
{% endblock %}
