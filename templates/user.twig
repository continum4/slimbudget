{% extends 'base.twig' %}
{% block title %}{{ t('users.edit') }}{% endblock %}
{% block content %}
<section class="card"><h1>{{ t('users.edit') }}</h1><form method="post" action="/users/{{ user.id }}" class="form-grid">{{ csrf() }}{{ include('_user_fields.twig', {v: user}) }}
<div class="field"><label><input type="checkbox" name="active" value="1"{% if user.active %} checked{% endif %}> {{ t('app.active') }}</label></div>
<div class="field"><label><input type="checkbox" name="reset_password" value="1"> {{ t('users.reset') }}</label></div>
<div class="field form-end"><button class="primary">{{ t('app.save') }}</button> <a class="button" href="/users">{{ t('app.cancel') }}</a></div></form></section>
{% endblock %}
