{% for field, d in catalog.fields %}
{% set type = d[0] %}{% set label = t('catalogs.fields.' ~ field) %}{% set value = old(field, row[field] ?? '') %}
<div class="field">
  {% if type == 'checkbox' %}<label><input type="checkbox" name="{{ field }}" value="1"{% if value %} checked{% endif %}> {{ label }}</label>
  {% else %}<label for="{{ field }}">{{ type ends with '?' ? t('app.optional', {label: label}) : label }}</label>
    {% if type starts with 'ref' %}<select id="{{ field }}" name="{{ field }}"{% if type == 'ref' %} required{% endif %}><option value="">{{ t(type == 'ref' ? 'app.choose' : 'app.none') }}</option>{% for o in references[field] %}<option value="{{ o.id }}"{% if o.id == value %} selected{% endif %}>{{ o.name }}</option>{% endfor %}</select>
    {% elseif type == 'option' %}<select id="{{ field }}" name="{{ field }}">{% for o in d[1] %}<option value="{{ o }}"{% if o == value %} selected{% endif %}>{{ t('modes.' ~ o) }}</option>{% endfor %}</select>
    {% elseif type starts with 'integer' %}<input type="number" id="{{ field }}" name="{{ field }}" min="{{ d[1][0] }}" max="{{ d[1][1] }}" value="{{ value }}"{% if type == 'integer' %} required{% endif %}>
    {% elseif type == 'amount' %}<input id="{{ field }}" name="{{ field }}" inputmode="decimal" pattern="{{ amount_pattern() }}" data-example="{{ amount_example() }}" value="{{ old(field, (row[field] ?? '')|amount) }}" required>
    {% else %}<input id="{{ field }}" name="{{ field }}" maxlength="{{ d[1] }}" autocomplete="off" value="{{ value }}"{% if type == 'text' %} required{% endif %}>{% endif %}
  {% endif %}
</div>
{% endfor %}
