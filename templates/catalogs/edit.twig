{% extends 'base.twig' %}
{% block title %}{{ t('catalogs.edit_one.' ~ catalog.key) }}{% endblock %}
{% block content %}
<section class="card edit"><h1>{{ t('catalogs.edit_one.' ~ catalog.key) }}</h1>
  <form method="post" action="/catalogs/{{ catalog.key }}/{{ row.id }}" class="form-grid">{{ csrf() }}{{ include('catalogs/_fields.twig') }}
    <div class="field"><label><input type="checkbox" name="active" value="1"{% if row.active %} checked{% endif %}> {{ t('app.active') }}</label></div>
    <div class="form-actions"><button class="primary">{{ t('app.save') }}</button><a class="button" href="/catalogs/{{ catalog.key }}">{{ t('app.cancel') }}</a><button class="danger" form="delete-row">{{ t('app.delete') }}</button></div></form>
  <form id="delete-row" method="post" action="/catalogs/{{ catalog.key }}/{{ row.id }}/delete" data-confirm="{{ t('app.confirm_delete', {name: row.name}) }}">{{ csrf() }}</form>
</section>
{% if catalog.key == 'cards' %}{{ include('_card_cycles.twig', {card: row}) }}{% endif %}
{% endblock %}
