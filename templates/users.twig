{% extends 'base.twig' %}
{% block title %}{{ t('users.title') }}{% endblock %}
{% block content %}
<h1>{{ t('users.title') }}</h1>
<section class="card"><h2>{{ t('users.add') }}</h2><form method="post" action="/users" class="form-grid">{{ csrf() }}{{ include('_user_fields.twig', {v: {username: '', name: '', role: 'member', person_id: ''}}) }}<div class="field form-end"><button class="primary">{{ t('users.create') }}</button></div></form>
<p class="note">{{ t('users.help') }}</p></section>
<section class="card"><h2>{{ t('users.accounts') }}</h2><div class="table-box"><table class="stackable"><caption class="visually-hidden">{{ t('users.accounts') }}</caption><thead><tr><th scope="col">{{ t('users.username') }}</th><th scope="col">{{ t('fields.name') }}</th><th scope="col">{{ t('users.role') }}</th><th scope="col">{{ t('fields.person') }}</th><th scope="col">{{ t('users.last_login') }}</th><th scope="col">{{ t('app.status') }}</th></tr></thead><tbody>
{% for u in users %}<tr{% if not u.active %} class="inactive"{% endif %}><th scope="row"><a href="/users/{{ u.id }}">{{ u.username }}</a></th><td data-t="{{ t('fields.name') }}">{{ u.name }}</td><td data-t="{{ t('users.role') }}">{{ t('users.roles.' ~ u.role) }}</td><td data-t="{{ t('fields.person') }}">{{ u.person ?? '—' }}</td><td data-t="{{ t('users.last_login') }}">{{ u.last_login_at|datetime }}</td><td data-t="{{ t('app.status') }}">{{ t(u.active ? 'app.active' : 'app.inactive') }}</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
