{
    "name": "continum4/slimbudget",
    "description": "A small self-hosted household budget: monthly estimates, expenses, bills and installment plans.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "bacon/bacon-qr-code": "^3.1",
        "php-di/php-di": "^7.1",
        "psr/clock": "^1.0",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit tests/Unit",
        "test:e2e": "php tests/e2e/run.php"
    },
    "config": { "sort-packages": true, "optimize-autoloader": true }
}
